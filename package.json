{
	"name": "bold-punctuation-fix",
	"version": "1.0.1",
	"description": "Repair Markdown bold markers adjacent to punctuation by moving boundary punctuation outside the bold span.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "node --import tsx --test tests/*.test.ts"
	},
	"keywords": [
		"obsidian",
		"markdown",
		"bold",
		"punctuation",
		"formatting"
	],
	"author": "JaewonE",
	"homepage": "https://github.com/jaewonE/bold-punctuation-fix",
	"license": "0-BSD",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1",
		"tsx": "^4.20.6"
	}
}
